---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'

const entries = await getCollection('compendium')
const sorted = entries.sort((a, b) => a.data.title.localeCompare(b.data.title))
const allTags = [...new Set(sorted.flatMap(e => e.data.tags))].sort()
---

<Base title="Compendium" description="A geographic and environmental record of Kuha" dark={true}>

  <div class="compendium-header">
    <div class="entry-type">Reference</div>
    <h1>Compendium</h1>
    <p class="compendium-intro">A geographic and environmental record of the continent Kuha for those seeking an omnipotent view.</p>
  </div>

  {allTags.length > 0 && (
    <div class="compendium-section">
      <div class="compendium-filter">
        <button class="tag-btn active" data-tag="all">All</button>
        {allTags.map(tag => (
          <button class="tag-btn" data-tag={tag}>{tag}</button>
        ))}
      </div>
    </div>
  )}

  <div class="compendium-section">
    <h2 class="compendium-section-title">Entries</h2>
    <div class="world-grid">
  {sorted.map((entry) => {
    const href = '/compendium/' + entry.id
    const tags = entry.data.tags.join(',')
    return (
      <a href={href} class="world-card" data-tags={tags}>
        <div class="world-card-body">
          <div class="compendium-card-meta">
            <span class="compendium-type">{entry.data.type}</span>
            {entry.data.region && (
              <span class="compendium-region">{entry.data.region}</span>
            )}
          </div>
          <h3 class="world-card-title">{entry.data.title}</h3>
          {entry.data.excerpt && (
            <p class="world-card-excerpt">{entry.data.excerpt}</p>
          )}
          {entry.data.tags.length > 0 && (
            <ul class="compendium-tags">
              {entry.data.tags.map(tag => (
                <li class="compendium-tag">{tag}</li>
              ))}
            </ul>
          )}
        </div>
      </a>
    )
  })}
</div>
  </div>

</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn')
  const cards = document.querySelectorAll<HTMLAnchorElement>('.world-card[data-tags]')

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag
      buttons.forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      cards.forEach(card => {
        if (tag === 'all') {
          card.style.display = ''
        } else {
          const cardTags = card.dataset.tags?.split(',') ?? []
          card.style.display = cardTags.includes(tag) ? '' : 'none'
        }
      })
    })
  })

  const params = new URLSearchParams(window.location.search)
  const preselect = params.get('tag')
  if (preselect) {
    const match = document.querySelector<HTMLButtonElement>(
      `.tag-btn[data-tag="${preselect}"]`
    )
    if (match) match.click()
  }
</script>

<style is:global>
  main:has(.compendium-header) {
    max-width:     1200px;
    padding-left:  3rem;
    padding-right: 3rem;
  }

  .compendium-header {
    margin-bottom:  2rem;
    padding-bottom: 2rem;
    border-bottom:  1px solid var(--colour-border);
  }

  .compendium-intro {
    font-style: italic;
    color:      var(--colour-ink-muted);
    font-size:  1.05rem;
    margin-top: 0.5rem;
  }

  .compendium-section {
    margin-bottom: 3rem;
  }

  .compendium-section-title {
    font-family:    var(--font-mono);
    font-size:      13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--colour-ink-muted);
    margin:         0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom:  1px solid var(--colour-border);
    font-style:     normal;
  }

  .compendium-filter {
    display:   flex;
    flex-wrap: wrap;
    gap:       0.4rem;
  }

  .tag-btn {
    cursor:         pointer;
    border:         none;
    background:     rgba(229, 131, 94, 0.1);
    font-family:    var(--font-mono);
    font-size:      12px;
    letter-spacing: 0.05em;
    color:          var(--colour-accent);
    padding:        3px 10px;
    border-radius:  2px;
    transition:     all 0.15s;
  }

  .tag-btn:hover { background: rgba(229, 131, 94, 0.2); }

  .tag-btn.active {
    background: var(--colour-accent);
    color:      var(--colour-bg);
  }

  .compendium-card-meta {
    display:       flex;
    gap:           0.5rem;
    margin-bottom: 0.4rem;
    align-items:   center;
  }

  .compendium-type,
  .compendium-region {
    font-family:    var(--font-mono);
    font-size:      11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--colour-accent);
  }

  .compendium-type::after {
    content:     '·';
    margin-left: 0.5rem;
    color:       var(--colour-ink-muted);
  }

  .compendium-tags {
    list-style:  none;
    padding:     0;
    margin:      0.75rem 0 0;
    padding-top: 0.75rem;
    border-top:  1px solid var(--colour-border);
    display:     flex;
    flex-wrap:   wrap;
    gap:         0.3rem;
  }

  .compendium-tag {
    font-family:    var(--font-mono);
    font-size:      10px;
    letter-spacing: 0.05em;
    background:     rgba(229, 131, 94, 0.1);
    color:          var(--colour-accent);
    padding:        2px 8px;
    border-radius:  2px;
  }

  @media (max-width: 700px) {
  .world-grid {
    grid-template-columns: 1fr;
  }

  main:has(.world-header) {
    padding-left:  1.5rem;
    padding-right: 1.5rem;
  }
}
</style>