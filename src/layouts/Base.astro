---
// Base.astro — wraps every page on the site
// Change the nav here and it updates everywhere

import '../styles/global.css'

interface Props {
  title: string
  description?: string
  dark?: boolean
}

const { title, description = 'A world of the ancient past', dark = false } = Astro.props
const currentPath = Astro.url.pathname
---

<html lang="en" class={dark ? 'compendium-dark' : ''}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — Imaginary Yonder</title>
</head>
<body>

  <header class="site-header">
    <a href="/" class="site-title">Imaginary Yonder</a>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" id="site-nav">
      <a href="/world" class:list={[{ active: currentPath.startsWith('/world') }]}>
        The World
      </a>
      <a href="/fragments" class:list={[{ active: currentPath.startsWith('/fragments') }]}>
        The Fragments
      </a>
      <a href="/journal" class:list={[{ active: currentPath.startsWith('/journal') }]}>
        Journal
      </a>
      <a href="/start-here" class:list={[{ active: currentPath === '/start-here' }]}>
        First Time Here
      </a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <p>Imaginary Yonder — a world building project</p>
  </footer>

</body>
</html>

<script>
  const toggle = document.querySelector('.nav-toggle')
  const nav = document.querySelector('.site-nav')

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!expanded))
    nav?.classList.toggle('is-open')
  })
</script>

<style is:global>
  .nav-toggle {
    display:        none;
    flex-direction: column